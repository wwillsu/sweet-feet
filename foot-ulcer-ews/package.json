{
  "name": "foot-ulcer-ews",
  "private": true,
  "engines": { "node": ">=20" },
  "type": "module",
  "scripts": {
    "dev": "convex dev --start \"npm run web\"",
    "web": "vite --config dashboard/vite.config.ts --open",
    "build": "tsc -p dashboard && tsc -p convex && vite build --config dashboard/vite.config.ts",
    "typecheck": "tsc -p dashboard && tsc -p convex",
    "setup-key": "node scripts/setup-key.mjs"
  },
  "dependencies": {
    "convex": "^1.48.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
